pipeline {
    agent any
    
    tools {
        jdk "JDK-25"
        maven "maven -3"
    }

    parameters {
        choice(
            name: "ENV",
            choices: ['sit', 'uat'],
            description: 'select environment'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                // Step 1: Pull the code from GitHub
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                // Step 2: Compile and run the automation
                echo "Building and running tests for: ${params.ENV}"
                sh "mvn clean test -Denv=${params.ENV}"
            }
        }
    }

    post {
        always {
            // Optional: Publish TestNG results to Jenkins UI
            junit '**/target/surefire-reports/*.xml'
        }
    }
}
